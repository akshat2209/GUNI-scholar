import { AlertTriangle, Inbox, Loader2 } from 'lucide-react'
import { Link } from 'react-router-dom'

export function PageHeader({ title, sub, actions }) {
  return (
    <div className="page-header">
      <div>
        <h1>{title}</h1>
        {sub && <p className="sub">{sub}</p>}
      </div>
      {actions && <div className="page-actions">{actions}</div>}
    </div>
  )
}

export function Card({ title, actions, children, tight, className = '' }) {
  return (
    <section className={`card ${className}`}>
      {(title || actions) && (
        <div className="card-head">
          <h2>{title}</h2>
          {actions}
        </div>
      )}
      <div className={tight ? 'card-body-tight' : 'card-body'}>{children}</div>
    </section>
  )
}

export function StatCard({ label, value, meta }) {
  return (
    <div className="card stat-card">
      <span className="accent-bar" aria-hidden="true" />
      <span className="label">{label}</span>
      <span className="value">{value}</span>
      {meta && <span className="meta">{meta}</span>}
    </div>
  )
}

export function Badge({ tone = 'neutral', children }) {
  return <span className={`badge badge-${tone}`}>{children}</span>
}

export function riskTone(band) {
  return band === 'High' ? 'bad' : band === 'Medium' ? 'warn' : 'ok'
}

export function Loading({ label = 'Loading' }) {
  return (
    <div className="spinner-wrap" role="status">
      <span className="spinner" aria-hidden="true" />
      <span>{label}...</span>
    </div>
  )
}

export function EmptyState({ icon: Icon = Inbox, title, children, action }) {
  return (
    <div className="empty-state">
      {Icon && <Icon className="icon" size={34} strokeWidth={1.5} aria-hidden="true" />}
      <h3>{title}</h3>
      {children && <p>{children}</p>}
      {action && <div className="mt-16">{action}</div>}
    </div>
  )
}

export function ErrorEmpty({ title = 'Not enough data yet', children }) {
  return (
    <EmptyState icon={AlertTriangle} title={title}>
      {children}
    </EmptyState>
  )
}

export function MasteryRow({ name, value }) {
  const band = value == null ? { key: 'none', label: 'Not assessed' } : value >= 70 ? { key: 'ok', label: 'Mastered' } : value >= 40 ? { key: 'warn', label: 'Developing' } : { key: 'bad', label: 'Needs work' }
  return (
    <div className="mastery-row">
      <span className="t">{name}</span>
      <div className={`progress ${band.key === 'none' ? '' : band.key}`} role="img" aria-label={`${name}: ${value == null ? 'not assessed' : value + ' percent, ' + band.label}`}>
        {value != null && <span style={{ width: `${value}%` }} />}
      </div>
      <span className="v">{value == null ? 'N/A' : `${value}%`}</span>
    </div>
  )
}

export function Field({ label, error, hint, children, htmlFor }) {
  return (
    <div className="field">
      <label htmlFor={htmlFor}>{label}</label>
      {children}
      {hint && !error && <span className="field-hint" id={htmlFor + '-hint'}>{hint}</span>}
      {error && <span className="field-error" id={htmlFor + '-error'} role="alert">{error}</span>}
    </div>
  )
}

export function Tabs({ tabs, active, onChange, label = 'Sections' }) {
  return (
    <div className="tabs" role="tablist" aria-label={label}>
      {tabs.map((t) => (
        <button key={t.id} role="tab" aria-selected={active === t.id} className="tab-btn" onClick={() => onChange(t.id)}>
          {t.label}
        </button>
      ))}
    </div>
  )
}

export function Crumb({ to, children }) {
  return <Link to={to} className="small" style={{ textDecoration: 'none' }}>&larr; {children}</Link>
}

export function ScoreBadge({ score, total }) {
  const pct = Math.round((100 * score) / total)
  const tone = pct >= 70 ? 'ok' : pct >= 40 ? 'warn' : 'bad'
  return <Badge tone={tone}>{pct}% ({score}/{total})</Badge>
}

export { Loader2 }
